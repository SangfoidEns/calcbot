<!DOCTYPE html>
<html lang="uk" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Humans 2.0 Engine</title>
  
  <!-- Tailwind CSS & Chart.js CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brandDark: '#090A0F',
            brandCard: '#12141D',
            brandBorder: '#1E2230',
            neonGreen: '#00FF88',
            neonPurple: '#9D00FF',
            neonRed: '#FF3366',
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #090A0F;
      color: #E2E8F0;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .neon-border {
      border: 1px solid rgba(0, 255, 136, 0.2);
      box-shadow: 0 0 15px rgba(0, 255, 136, 0.05);
    }
    .neon-border-purple {
      border: 1px solid rgba(157, 0, 255, 0.2);
      box-shadow: 0 0 15px rgba(157, 0, 255, 0.05);
    }
  </style>
</head>
<body class="min-h-screen p-4 md:p-6">

  <div class="max-w-7xl mx-auto space-y-6">

    <!-- Header -->
    <header class="flex flex-col md:flex-row justify-between items-center p-4 bg-brandCard rounded-2xl neon-border gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-neonGreen to-neonPurple flex items-center justify-center font-bold text-black text-xl">
          H2
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-wider text-white">HUMANS <span class="text-neonGreen">2.0</span> ENGINE</h1>
          <p class="text-xs text-gray-400">Обчислювальний движок з обліком власних витрат</p>
        </div>
      </div>
      <div class="flex gap-2">
        <button onclick="loadSampleData()" class="px-4 py-2 text-xs font-semibold rounded-xl bg-brandBorder hover:bg-gray-800 text-neonGreen border border-neonGreen/30 transition">
          Завантажити приклад
        </button>
        <button onclick="clearAllData()" class="px-4 py-2 text-xs font-semibold rounded-xl bg-brandBorder hover:bg-red-900/30 text-red-400 border border-red-500/30 transition">
          Очистити
        </button>
      </div>
    </header>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Left Input Column & My Expenses Section -->
      <div class="lg:col-span-1 space-y-6">
        
        <!-- Input Journal -->
        <div class="bg-brandCard p-5 rounded-2xl neon-border space-y-4">
          <div class="flex justify-between items-center">
            <h2 class="text-sm font-bold tracking-wider uppercase text-gray-300">Вхідні дані (Журнал)</h2>
            <span class="text-xs px-2 py-0.5 rounded bg-neonGreen/10 text-neonGreen border border-neonGreen/30">HTML Input</span>
          </div>
          
          <textarea id="rawInput" class="w-full h-64 p-3 bg-brandDark rounded-xl border border-brandBorder text-xs font-mono text-gray-200 focus:outline-none focus:border-neonGreen/50 transition resize-none" placeholder="Вставити журнал угод..."></textarea>

          <button onclick="processData()" class="w-full py-3 bg-gradient-to-r from-neonGreen to-emerald-400 text-black font-bold rounded-xl shadow-lg shadow-neonGreen/20 hover:opacity-95 transition">
            Розрахувати (Humans2.0)
          </button>
        </div>

        <!-- CATEGORY "МОЇ" (EXPENSES MANAGEMENT) -->
        <div class="bg-brandCard p-5 rounded-2xl neon-border-purple space-y-4">
          <div class="flex justify-between items-center border-b border-brandBorder pb-2">
            <h2 class="text-sm font-bold tracking-wider uppercase text-neonPurple">Категорія "МОЇ" (Розходи/Доходи)</h2>
            <span class="text-xs font-mono font-bold text-white" id="myTotalDisplay">0 €</span>
          </div>

          <div class="space-y-3">
            <div class="flex gap-2">
              <input type="text" id="myExpenseNote" placeholder="Опис (напр. Бензин, Оренда)" class="w-2/3 px-3 py-2 bg-brandDark rounded-xl border border-brandBorder text-xs text-gray-200 focus:outline-none">
              <input type="number" id="myExpenseAmount" placeholder="Сума €" class="w-1/3 px-3 py-2 bg-brandDark rounded-xl border border-brandBorder text-xs text-gray-200 focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-2">
              <button onclick="addMyExpense('add')" class="py-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-bold hover:bg-emerald-500/30 transition">
                + Додати (+€)
              </button>
              <button onclick="addMyExpense('sub')" class="py-2 bg-red-500/20 text-red-400 border border-red-500/30 rounded-xl text-xs font-bold hover:bg-red-500/30 transition">
                - Відняти (-€)
              </button>
            </div>
          </div>

          <!-- History of 'МОЇ' -->
          <div class="pt-2">
            <p class="text-[10px] font-bold uppercase text-gray-400 mb-2">Історія записів "МОЇ":</p>
            <div id="myExpensesList" class="space-y-1.5 max-h-32 overflow-y-auto text-xs pr-1">
              <p class="text-gray-500">Записи відсутні</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Dashboard Column -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Output Structure / KPIs -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          <div class="bg-brandCard p-3 rounded-xl neon-border">
            <p class="text-[10px] font-medium text-gray-400">Фактично отримано</p>
            <p class="text-base font-black text-white mt-1" id="kpiRevenue">0 €</p>
          </div>
          <div class="bg-brandCard p-3 rounded-xl neon-border">
            <p class="text-[10px] font-medium text-gray-400">Активний борг</p>
            <p class="text-base font-black text-neonRed mt-1" id="kpiActiveDebt">0 €</p>
          </div>
          <div class="bg-brandCard p-3 rounded-xl neon-border">
            <p class="text-[10px] font-medium text-gray-400">Повернуто боргів</p>
            <p class="text-base font-black text-emerald-400 mt-1" id="kpiPaidDebt">0 €</p>
          </div>
          <div class="bg-brandCard p-3 rounded-xl neon-border-purple">
            <p class="text-[10px] font-medium text-gray-400">Базова вага</p>
            <p class="text-base font-black text-white mt-1" id="kpiBaseWeight">0.00 г</p>
          </div>
          <div class="bg-brandCard p-3 rounded-xl neon-border-purple">
            <p class="text-[10px] font-medium text-gray-400">Точна вага (+0.1г)</p>
            <p class="text-base font-black text-neonGreen mt-1" id="kpiExactWeight">0.00 г</p>
          </div>
          <div class="bg-brandCard p-3 rounded-xl neon-border-purple">
            <p class="text-[10px] font-medium text-gray-400">Кількість угод</p>
            <p class="text-base font-black text-neonPurple mt-1" id="kpiDeals">0</p>
          </div>
        </div>

        <!-- Debts Breakdown -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-brandCard p-4 rounded-xl border border-red-500/20">
            <h3 class="text-xs font-bold uppercase text-neonRed mb-2">🔴 Активні борги клієнтів</h3>
            <div id="activeDebtsList" class="text-xs space-y-1.5 max-h-36 overflow-y-auto text-gray-300">
              <p class="text-gray-500">Немає даних</p>
            </div>
          </div>

          <div class="bg-brandCard p-4 rounded-xl border border-emerald-500/20">
            <h3 class="text-xs font-bold uppercase text-emerald-400 mb-2">🟢 Погашення боргів (Debt_Repaid)</h3>
            <div id="repaidDebtsList" class="text-xs space-y-1.5 max-h-36 overflow-y-auto text-gray-300">
              <p class="text-gray-500">Немає даних</p>
            </div>
          </div>
        </div>

        <!-- Charts -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-brandCard p-4 rounded-2xl neon-border">
            <h3 class="text-xs font-bold text-gray-300 uppercase mb-2">Точна вага за сортами (г)</h3>
            <div class="h-40 relative">
              <canvas id="weightBarChart"></canvas>
            </div>
          </div>
          <div class="bg-brandCard p-4 rounded-2xl neon-border">
            <h3 class="text-xs font-bold text-gray-300 uppercase mb-2">Отримано коштів за сортами (€)</h3>
            <div class="h-40 relative">
              <canvas id="revenuePieChart"></canvas>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Category Breakdown Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="categorySummaryCards">
      <!-- Dynamic Category Cards -->
    </div>

    <!-- Detailed Table -->
    <div class="bg-brandCard p-5 rounded-2xl neon-border space-y-4">
      <div class="flex justify-between items-center flex-wrap gap-2">
        <h2 class="text-sm font-bold tracking-wider uppercase text-gray-300">Журнал розпарсених угод</h2>
        <input type="text" id="tableSearch" onkeyup="filterTable()" placeholder="Пошук..." class="px-3 py-1.5 bg-brandDark rounded-lg border border-brandBorder text-xs text-gray-200 focus:outline-none">
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-gray-300">
          <thead class="bg-brandDark text-gray-400 uppercase text-[10px]">
            <tr>
              <th class="p-3">Сорт</th>
              <th class="p-3">Клієнт</th>
              <th class="p-3">Base_Gramm</th>
              <th class="p-3 text-neonGreen">Exact_Gramm (* 1.1)</th>
              <th class="p-3">EUR_Paid</th>
              <th class="p-3">Запис боргу</th>
              <th class="p-3">Час</th>
            </tr>
          </thead>
          <tbody id="recordsTableBody" class="divide-y divide-brandBorder">
            <!-- Dynamic Rows -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    let barChart, pieChart;
    let myExpenses = [];

    // --- CATEGORY "МОЇ" LOGIC ---
    function addMyExpense(type) {
      const noteInput = document.getElementById('myExpenseNote');
      const amountInput = document.getElementById('myExpenseAmount');

      const note = noteInput.value.trim() || 'Без опису';
      let amount = parseFloat(amountInput.value);

      if (isNaN(amount) || amount <= 0) return;

      if (type === 'sub') amount = -amount; // Віднімаємо розхід

      myExpenses.push({
        id: Date.now(),
        note,
        amount,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      });

      noteInput.value = '';
      amountInput.value = '';

      saveMyExpenses();
      processData();
    }

    function removeMyExpense(id) {
      myExpenses = myExpenses.filter(item => item.id !== id);
      saveMyExpenses();
      processData();
    }

    function saveMyExpenses() {
      localStorage.setItem('h2_my_expenses', JSON.stringify(myExpenses));
    }

    function loadMyExpenses() {
      const saved = localStorage.getItem('h2_my_expenses');
      if (saved) {
        try { myExpenses = JSON.parse(saved); } catch(e) { myExpenses = []; }
      }
    }

    // --- RULE 1: WEIGHT MATH ---
    function parseWeight(str) {
      if (!str) return 0;
      const clean = str.toString().toLowerCase().replace(',', '.');
      const matches = clean.match(/\d*\.?\d+/g);
      if (!matches) return 0;
      return matches.reduce((acc, curr) => acc + parseFloat(curr), 0);
    }

    // --- RULE 2: MONEY & DEBT LOGIC ---
    function parseMoneyAndDebt(str) {
      if (!str) return { eurPaid: 0, debtNew: 0, debtRepaid: 0, rawDebtText: '' };

      const clean = str.toString().toLowerCase().replace(',', '.').trim();
      let eurPaid = 0;
      let debtNew = 0;
      let debtRepaid = 0;
      let rawDebtText = '';

      if (clean.includes('долг')) {
        rawDebtText = clean;
        const tokens = clean.split(/\s+/);

        tokens.forEach(token => {
          if (token.includes('долг')) {
            const numMatch = token.match(/[-+]?\d*\.?\d+/);
            if (numMatch) {
              const val = parseFloat(numMatch[0]);
              if (val < 0) {
                debtNew += Math.abs(val);
              } else if (val > 0) {
                debtRepaid += val;
              }
            }
          } else {
            const num = parseFloat(token);
            if (!isNaN(num) && num > 0) {
              eurPaid += num;
            }
          }
        });
      } else {
        const matches = clean.match(/\d*\.?\d+/g);
        if (matches) {
          eurPaid = matches.reduce((acc, curr) => acc + parseFloat(curr), 0);
        }
      }

      return { eurPaid, debtNew, debtRepaid, rawDebtText };
    }

    // --- RULE 3: PARSER FOR INPUT LOGS ---
    function parseLogs(rawText) {
      const lines = rawText.split('\n').map(l => l.trim()).filter(l => l !== '');
      let currentCategory = 'Uncategorized';
      const records = [];

      const techHeaders = ['name', 'gramm', '€', 'time'];

      let i = 0;
      while (i < lines.length) {
        const line = lines[i];

        if (i + 3 < lines.length && 
            lines[i+1].toLowerCase() === 'name' && 
            lines[i+2].toLowerCase() === 'gramm' && 
            lines[i+3] === '€') {
          currentCategory = line.toUpperCase();
          i += 5;
          continue;
        }

        if (techHeaders.includes(line.toLowerCase())) {
          i++;
          continue;
        }

        if (i + 3 < lines.length) {
          const clientName = lines[i];
          const rawGramm = lines[i+1];
          const rawMoney = lines[i+2];
          const timeStr = lines[i+3];

          if (timeStr.includes('.') || timeStr.includes(':')) {
            const baseGramm = parseWeight(rawGramm);
            const exactGramm = baseGramm * 1.1;

            const moneyData = parseMoneyAndDebt(rawMoney);

            records.push({
              category: currentCategory,
              clientName,
              rawGramm,
              baseGramm,
              exactGramm,
              rawMoney,
              eurPaid: moneyData.eurPaid,
              debtNew: moneyData.debtNew,
              debtRepaid: moneyData.debtRepaid,
              rawDebtText: moneyData.rawDebtText,
              timeStr
            });

            i += 4;
            continue;
          }
        }
        i++;
      }
      return records;
    }

    // --- MAIN ENGINE PROCESSOR ---
    function processData() {
      const rawText = document.getElementById('rawInput').value;
      localStorage.setItem('h2_raw_logs', rawText);

      const records = parseLogs(rawText);

      let totalEURPaid = 0;
      let totalBaseGramm = 0;
      let totalExactGramm = 0;

      const clientNewDebts = {};
      const clientRepaidDebts = {};
      const categories = {};

      records.forEach(r => {
        totalEURPaid += r.eurPaid;
        totalBaseGramm += r.baseGramm;
        totalExactGramm += r.exactGramm;

        if (r.debtNew > 0) {
          clientNewDebts[r.clientName] = (clientNewDebts[r.clientName] || 0) + r.debtNew;
        }
        if (r.debtRepaid > 0) {
          clientRepaidDebts[r.clientName] = (clientRepaidDebts[r.clientName] || 0) + r.debtRepaid;
        }

        if (!categories[r.category]) {
          categories[r.category] = {
            deals: 0,
            baseGramm: 0,
            exactGramm: 0,
            eurPaid: 0,
          };
        }

        categories[r.category].deals += 1;
        categories[r.category].baseGramm += r.baseGramm;
        categories[r.category].exactGramm += r.exactGramm;
        categories[r.category].eurPaid += r.eurPaid;
      });

      // --- PROCESS CATEGORY "МОЇ" ---
      let myTotalSum = 0;
      myExpenses.forEach(item => {
        myTotalSum += item.amount;
      });

      // Add "МОЇ" to Total Revenue (EUR_Paid)
      totalEURPaid += myTotalSum;

      // Add "МОЇ" into categories object for rendering
      categories['МОЇ'] = {
        deals: myExpenses.length,
        baseGramm: 0,
        exactGramm: 0,
        eurPaid: myTotalSum
      };

      // Active Debt Calculations
      const clientActiveDebts = {};
      let totalActiveDebt = 0;
      let totalRepaidDebt = 0;

      Object.keys(clientRepaidDebts).forEach(name => {
        totalRepaidDebt += clientRepaidDebts[name];
      });

      const allClients = new Set([...Object.keys(clientNewDebts), ...Object.keys(clientRepaidDebts)]);
      allClients.forEach(name => {
        const newD = clientNewDebts[name] || 0;
        const repD = clientRepaidDebts[name] || 0;
        const active = newD - repD;

        if (active > 0) {
          clientActiveDebts[name] = active;
          totalActiveDebt += active;
        }
      });

      // UPDATE OUTPUT DASHBOARD
      document.getElementById('kpiRevenue').innerText = `${totalEURPaid.toFixed(0)} €`;
      document.getElementById('kpiActiveDebt').innerText = `${totalActiveDebt.toFixed(0)} €`;
      document.getElementById('kpiPaidDebt').innerText = `+${totalRepaidDebt.toFixed(0)} €`;
      document.getElementById('kpiBaseWeight').innerText = `${totalBaseGramm.toFixed(2)} г`;
      document.getElementById('kpiExactWeight').innerText = `${totalExactGramm.toFixed(2)} г`;
      document.getElementById('kpiDeals').innerText = records.length;

      // Render My Expenses UI
      renderMyExpensesUI(myTotalSum);

      // Render Debts Lists
      renderDebtsList('activeDebtsList', clientActiveDebts, 'text-neonRed', '-');
      renderDebtsList('repaidDebtsList', clientRepaidDebts, 'text-emerald-400', '+');

      // Render Categories Cards & Tables
      renderCategoryCards(categories);
      renderTable(records);
      renderCharts(categories);
    }

    function renderMyExpensesUI(totalSum) {
      document.getElementById('myTotalDisplay').innerText = `${totalSum >= 0 ? '+' : ''}${totalSum.toFixed(0)} €`;
      document.getElementById('myTotalDisplay').className = `text-xs font-mono font-bold ${totalSum >= 0 ? 'text-emerald-400' : 'text-neonRed'}`;

      const container = document.getElementById('myExpensesList');
      if (myExpenses.length === 0) {
        container.innerHTML = '<p class="text-gray-500">Записи відсутні</p>';
        return;
      }

      container.innerHTML = myExpenses.map(item => `
        <div class="flex justify-between items-center border-b border-brandBorder/50 pb-1">
          <span class="text-gray-300">${item.note} <span class="text-[10px] text-gray-500">(${item.time})</span></span>
          <div class="flex items-center gap-2">
            <span class="font-bold font-mono ${item.amount >= 0 ? 'text-emerald-400' : 'text-neonRed'}">
              ${item.amount >= 0 ? '+' : ''}${item.amount} €
            </span>
            <button onclick="removeMyExpense(${item.id})" class="text-red-400 hover:text-red-300 text-xs px-1">✕</button>
          </div>
        </div>
      `).join('');
    }

    function renderDebtsList(elementId, debtMap, textColorClass, prefix) {
      const container = document.getElementById(elementId);
      const keys = Object.keys(debtMap);
      if (keys.length === 0) {
        container.innerHTML = '<p class="text-gray-500">Записи відсутні</p>';
        return;
      }
      container.innerHTML = keys.map(name => `
        <div class="flex justify-between items-center border-b border-brandBorder/50 pb-1">
          <span>${name}</span>
          <span class="font-bold font-mono ${textColorClass}">${prefix}${debtMap[name].toFixed(0)} €</span>
        </div>
      `).join('');
    }

    function renderCategoryCards(categories) {
      const container = document.getElementById('categorySummaryCards');
      container.innerHTML = Object.keys(categories).map(catName => {
        const cat = categories[catName];
        return `
          <div class="bg-brandCard p-4 rounded-2xl neon-border space-y-2">
            <h3 class="text-base font-bold text-neonPurple border-b border-brandBorder pb-2">${catName}</h3>
            <div class="grid grid-cols-2 gap-2 text-xs text-gray-300">
              <div>Кількість: <span class="font-bold text-white">${cat.deals}</span></div>
              <div>EUR_Paid: <span class="font-bold text-white">${cat.eurPaid.toFixed(0)} €</span></div>
              ${catName !== 'МОЇ' ? `
                <div>Base_Gramm: <span class="font-bold text-white">${cat.baseGramm.toFixed(2)} г</span></div>
                <div>Exact_Gramm: <span class="font-bold text-neonGreen">${cat.exactGramm.toFixed(2)} г</span></div>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderTable(records) {
      const tbody = document.getElementById('recordsTableBody');
      tbody.innerHTML = records.map(r => `
        <tr class="hover:bg-brandDark/50 transition">
          <td class="p-3 font-semibold text-neonPurple">${r.category}</td>
          <td class="p-3 text-white font-medium">${r.clientName}</td>
          <td class="p-3">${r.baseGramm} г</td>
          <td class="p-3 font-bold text-neonGreen">${r.exactGramm.toFixed(2)} г</td>
          <td class="p-3 font-semibold text-white">${r.eurPaid} €</td>
          <td class="p-3 font-mono ${r.rawDebtText ? 'text-yellow-400 font-bold' : 'text-gray-500'}">${r.rawMoney}</td>
          <td class="p-3 text-gray-400">${r.timeStr}</td>
        </tr>
      `).join('');
    }

    function filterTable() {
      const q = document.getElementById('tableSearch').value.toLowerCase();
      const rows = document.querySelectorAll('#recordsTableBody tr');
      rows.forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    }

    function renderCharts(categories) {
      const catLabels = Object.keys(categories).filter(c => c !== 'МОЇ');
      const exactWeights = catLabels.map(c => categories[c].exactGramm);

      const allCatLabels = Object.keys(categories);
      const revenues = allCatLabels.map(c => categories[c].eurPaid);

      if (barChart) barChart.destroy();
      barChart = new Chart(document.getElementById('weightBarChart'), {
        type: 'bar',
        data: {
          labels: catLabels,
          datasets: [{ label: 'Exact_Gramm (г)', data: exactWeights, backgroundColor: '#00FF88', borderRadius: 6 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#888' } }, y: { ticks: { color: '#888' } } } }
      });

      if (pieChart) pieChart.destroy();
      pieChart = new Chart(document.getElementById('revenuePieChart'), {
        type: 'doughnut',
        data: {
          labels: allCatLabels,
          datasets: [{ data: revenues, backgroundColor: ['#9D00FF', '#00FF88', '#FF3366', '#3B82F6', '#F59E0B'], borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#888' } } } }
